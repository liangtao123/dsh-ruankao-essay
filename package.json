{
  "name": "dsh-ruankao-essay",
  "version": "0.1.0",
  "private": true,
  "description": "软考系统分析师／系统架构设计师论文助手（2026-10 机考口径）：题库查询 + 摘要≤300／正文 2000~2500 双框写作与 Word 交付（three skills: ruankao-essay-writing, ruankao-essay-review, ruankao-essay-bank）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "软考系分／架构论文助手",
    "description": "题库索引（系分＋架构 2016—2026）+ 摘要≤300／正文 2000~2500 双框论文写作、自评与 Word 交付"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/ruankao-essay-bank/SKILL.md",
    "assets/ruankao-essay-bank/references/topic-index-lite.md",
    "assets/ruankao-essay-bank/references/article_question.md",
    "assets/ruankao-essay-writing/SKILL.md",
    "assets/ruankao-essay-writing/references/writing-rules.md",
    "assets/ruankao-essay-writing/scripts/make-essay-doc.ps1",
    "assets/ruankao-essay-writing/scripts/check-essay.ps1",
    "assets/ruankao-essay-writing/scripts/ingest-essay.ps1",
    "assets/ruankao-essay-review/SKILL.md",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "soft-exam",
    "ruankao",
    "essay",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zm886/dsh-ruankao-essay.git"
  },
  "homepage": "https://github.com/Zm886/dsh-ruankao-essay#readme",
  "bugs": {
    "url": "https://github.com/Zm886/dsh-ruankao-essay/issues"
  },
  "license": "MIT"
}
